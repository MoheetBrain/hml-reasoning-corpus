{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hml.reasoning.local/schemas/trajectory.schema.json",
  "title": "HML reasoning corpus canonical trajectory",
  "description": "Representation-neutral source of truth for S0 -> a0 -> ... -> Sn.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "example_id",
    "dataset_split",
    "title",
    "problem",
    "gold_status",
    "hml_status",
    "reasoning_stages_used",
    "semantic_gap_ids",
    "states",
    "actions",
    "goal_discharged",
    "renderings",
    "verification"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "example_id": { "type": "string", "pattern": "^G(0[1-9]|10)$" },
    "dataset_split": { "const": "GOLD-10" },
    "title": { "type": "string", "minLength": 1 },
    "problem": { "$ref": "#/$defs/problem" },
    "gold_status": { "const": "GOLD_CANONICAL_VERIFIED" },
    "hml_status": { "enum": ["FAITHFUL", "GAP_DOCUMENTED"] },
    "reasoning_stages_used": {
      "type": "array",
      "items": { "type": "integer", "minimum": 1, "maximum": 16 },
      "uniqueItems": true,
      "minItems": 1
    },
    "semantic_gap_ids": {
      "type": "array",
      "items": { "type": "string", "pattern": "^GAP-[0-9]{4}$" },
      "uniqueItems": true
    },
    "states": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/state" }
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/action" }
    },
    "goal_discharged": { "type": "boolean" },
    "renderings": { "$ref": "#/$defs/renderings" },
    "verification": { "$ref": "#/$defs/verification" }
  },
  "$defs": {
    "problem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "statement", "domain", "answer", "expected_outcome"],
      "properties": {
        "source": { "const": "hand_authored_worked_mathematics" },
        "statement": { "type": "string", "minLength": 1 },
        "domain": { "type": "string", "minLength": 1 },
        "answer": { "type": "string", "minLength": 1 },
        "expected_outcome": {
          "enum": ["determined", "undetermined", "conditional"]
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_problem", "source_step", "authoring"],
      "properties": {
        "source_problem": { "type": "string", "minLength": 1 },
        "source_step": { "type": "string", "minLength": 1 },
        "authoring": { "const": "hand_authored" }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "status"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "statement": { "type": "string", "minLength": 1 },
        "status": {
          "enum": ["given", "assumed", "established", "goal_open", "goal_discharged", "undetermined", "obligation_open", "obligation_discharged"]
        }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "declarations",
        "objects",
        "types_domains",
        "facts",
        "assumptions",
        "goals",
        "subgoals",
        "unresolved_obligations",
        "epistemic_status",
        "dependencies",
        "provenance"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^S[0-9]+$" },
        "declarations": { "type": "array" },
        "objects": { "type": "array" },
        "types_domains": { "type": "array" },
        "facts": { "type": "array", "items": { "$ref": "#/$defs/claim" } },
        "assumptions": { "type": "array", "items": { "$ref": "#/$defs/claim" } },
        "goals": { "type": "array", "items": { "$ref": "#/$defs/claim" } },
        "subgoals": { "type": "array", "items": { "$ref": "#/$defs/claim" } },
        "unresolved_obligations": { "type": "array", "items": { "$ref": "#/$defs/claim" } },
        "epistemic_status": { "type": "array", "items": { "$ref": "#/$defs/claim" } },
        "dependencies": { "type": "array", "items": { "type": "string" } },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "precondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "status", "evidence"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "statement": { "type": "string", "minLength": 1 },
        "status": { "enum": ["satisfied", "not_required", "open", "failed"] },
        "evidence": { "type": "string", "minLength": 1 }
      }
    },
    "action_verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "method", "evidence"],
      "properties": {
        "status": { "enum": ["verified", "verified_as_undetermined", "verified_conditionally", "not_machine_verified"] },
        "method": { "type": "string", "minLength": 1 },
        "evidence": { "type": "string", "minLength": 1 }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "from_state",
        "to_state",
        "inputs",
        "operation",
        "dependencies",
        "warrant",
        "preconditions",
        "resulting_fact",
        "state_change",
        "verification",
        "reasoning_stages",
        "hml_support",
        "semantic_gap_ids",
        "provenance"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^a[0-9]+$" },
        "from_state": { "type": "string", "pattern": "^S[0-9]+$" },
        "to_state": { "type": "string", "pattern": "^S[0-9]+$" },
        "inputs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "operation": { "type": "string", "minLength": 1 },
        "dependencies": { "type": "array", "items": { "type": "string" } },
        "warrant": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "rule", "description"],
          "properties": {
            "kind": { "type": "string", "minLength": 1 },
            "rule": { "type": "string", "minLength": 1 },
            "description": { "type": "string", "minLength": 1 }
          }
        },
        "preconditions": { "type": "array", "items": { "$ref": "#/$defs/precondition" } },
        "resulting_fact": { "$ref": "#/$defs/claim" },
        "state_change": {
          "type": "object",
          "additionalProperties": false,
          "required": ["from", "to", "added_facts", "removed_obligations", "epistemic_update"],
          "properties": {
            "from": { "type": "string" },
            "to": { "type": "string" },
            "added_facts": { "type": "array", "items": { "type": "string" } },
            "removed_obligations": { "type": "array", "items": { "type": "string" } },
            "epistemic_update": { "type": "string", "minLength": 1 }
          }
        },
        "verification": { "$ref": "#/$defs/action_verification" },
        "reasoning_stages": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1, "maximum": 16 },
          "uniqueItems": true,
          "minItems": 1
        },
        "hml_support": {
          "enum": [
            "EXPRESSIBLE_CURRENT_HML",
            "EXPRESSIBLE_WITH_LIBRARY",
            "REQUIRES_MINOR_SURFACE_EXTENSION",
            "REQUIRES_NEW_CORE_SEMANTIC",
            "AMBIGUOUS_OR_HUMAN_IMPLICIT",
            "NOT_MACHINE_VERIFIABLE"
          ]
        },
        "semantic_gap_ids": {
          "type": "array",
          "items": { "type": "string", "pattern": "^GAP-[0-9]{4}$" },
          "uniqueItems": true
        },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "rendering": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "format"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "format": { "type": "string", "minLength": 1 },
        "expected": { "type": "string" },
        "hml_core_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    },
    "renderings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hml", "structured_english", "structured_control"],
      "properties": {
        "hml": { "$ref": "#/$defs/rendering" },
        "structured_english": { "$ref": "#/$defs/rendering" },
        "structured_control": { "$ref": "#/$defs/rendering" }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_status", "method", "checks", "hml_core_sha"],
      "properties": {
        "canonical_status": { "const": "VERIFIED" },
        "method": { "type": "string", "minLength": 1 },
        "checks": { "type": "array", "minItems": 1 },
        "hml_core_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    }
  }
}
