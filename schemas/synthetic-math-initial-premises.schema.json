{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hmltn.local/schemas/synthetic-math-initial-premises.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_corpus_sha256", "derivation_policy", "problems"],
  "properties": {
    "schema_version": {"const": "synthetic-math-initial-premises-0.1.0"},
    "source_corpus_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "derivation_policy": {"type": "string", "minLength": 1},
    "problems": {
      "type": "array",
      "minItems": 600,
      "maxItems": 600,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["problem_id", "source_problem_sha256", "premises"],
        "properties": {
          "problem_id": {"type": "string", "pattern": "^(ALG|GEN|CALC|PROB|LINALG|MIXED)-[0-9]{3}$"},
          "source_problem_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "premises": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "premise_id", "proposition", "source_origin", "scope", "status",
                "dependencies", "dependency_status", "source_span", "source_span_sha256",
                "source_problem_sha256"
              ],
              "properties": {
                "premise_id": {"type": "string", "pattern": "^(p0|i[0-9]{3})$"},
                "proposition": {"type": "string", "minLength": 1},
                "source_origin": {"enum": ["SOURCE_PROBLEM", "SOURCE_INITIAL_STATE"]},
                "scope": {"const": "global"},
                "status": {"const": "GIVEN"},
                "dependencies": {"type": "array", "maxItems": 0},
                "dependency_status": {"const": "SOURCE_GIVEN_NO_DEPENDENCIES"},
                "source_span": {"type": "string", "minLength": 1},
                "source_span_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "source_problem_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
              }
            }
          }
        }
      }
    }
  }
}
