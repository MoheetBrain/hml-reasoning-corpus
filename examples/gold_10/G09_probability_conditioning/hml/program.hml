# HML corpus rendering; hml_core commit: 164d1946e91216c093478132caa0d06427259682
module Gold09ProbabilityConditioning

rv A : RandomVariable[Real]
rv B : RandomVariable[Real]
require probability(A > 0.0) = 0.5
require probability(B > 0.0 | A > 0.0) = 0.8
def joint_probability : Probability := probability(A > 0.0 and B > 0.0)
